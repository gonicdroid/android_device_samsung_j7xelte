# Adoptable Storage
ro.crypto.volume.filenames_mode=aes-256-cts

# Audio
af.fast_track_multiplier=1
ro.vendor.audio_hal.force_voice_config=wide
ro.config.media_vol_steps=25
ro.config.vc_call_vol_steps=7

# Bluetooth
ro.bt.bdaddr_path=/efs/bluetooth/bt_addr
bluetooth.device.class_of_device=90,1,16
bluetooth.device.default_name=Samsung Galaxy J7 2016

# Graphics
ro.opengles.version=196610
debug.hwc.otf=1
debug.hwc.winupdate=1
debug.hwc.nodirtyregion=1
debug.sf.disable_backpressure=1
ro.sf.lcd_density=320
ro.hardware.egl=mali

# RIL
rild.libpath=/system/lib/libsec-ril.so
rild.libargs=-d /dev/umts_ipc0
exynos.ril.modempath=/dev/block/mmcblk0p5
exynos.ril.nvpath=/efs/
vendor.sec.rild.libpath=/vendor/lib/libsec-ril.so
vendor.sec.rild.libpath2=/vendor/lib/libsec-ril-dsds.so
persist.radio.sib16_support=1

# SoC
ro.soc.manufacturer=Samsung
ro.soc.model=Exynos 7870
ro.arch=exynos7870
ro.board.platform=exynos5
ro.vendor.product.device=a2corelte

# SurfaceFlinger
debug.sf.auto_latch_unsignaled=0
debug.sf.enable_hwc_vds=0
debug.sf.enable_transaction_tracing=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# HWC workaround - force GPU comp for layers without buffers
debug.hwc.force_gpu_comp=1
debug.sf.latch_unsignaled=0
debug.hwc.max_hw_overlays=1
debug.hwc.skip_validate=1

# WiFi
wifi.interface=wlan0

# Dalvik
ro.config.low_ram=true
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=96m
dalvik.vm.heapsize=256m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m


